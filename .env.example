# QUORUM — provider API keys
#
# Copy this file to `.env` in the repo root and fill in whichever keys you have.
# `.env` is gitignored — never commit real keys.
#
# bin/quorum.js loads this file automatically via Node's native
# process.loadEnvFile() (stable, verified present on this project's Node 24 —
# no dotenv dependency needed).
#
# Every provider is optional. `quorum campaign` (and any future live route)
# skips a provider cleanly when its key is absent — see bin/quorum.js's
# PROVIDER_ENV_VARS map for the exact var names each adapter reads.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# @google/genai accepts either of these; GEMINI_API_KEY takes precedence if both are set.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# QUORUM — CLI auth
#
# Base URL of the QUORUM web app that `quorum login`/`logout`/`whoami`
# (bin/lib/auth.js) talk to. Defaults to http://localhost:3000 for local dev
# when unset — only needed here if you're pointing the CLI at a different
# host (staging, a deployed instance, etc).
WEB_ORIGIN=

# QUORUM — live dashboard ledger mirror (optional)
#
# `quorum run` (bin/quorum.js) always writes real ledger events to the local
# .quorum/run-ledger.jsonl file, with zero credentials. When BOTH of these
# are set, it additionally mirrors every event to the `dispatch_ledger_events`
# table (see ledger/supabase-store.js) that kevin_frontend's
# GET /api/dashboard/snapshot route reads from — this is what makes the live
# dashboard show real data instead of sample data. Leave unset to run with
# the local ledger only; a missing/incomplete pair here is never an error,
# just a clear log line and a local-only run.
#
# Same project kevin_frontend's own .env points at (see that repo's
# .env.example) and the same one packages/stake/policy/identity-registry-
# supabase.js already writes to — one shared Supabase project across both
# repos, not a separate one for dispatch.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Copy to .env and fill in before running `npm run deploy:sepolia`.
# Never commit the real .env — it is gitignored.

# A funded Sepolia testnet wallet's private key (0x-prefixed hex).
# Generate one with `node scripts/generate-wallet.js` if you don't have one,
# then fund the printed address from a Sepolia faucet before deploying.
SEPOLIA_PRIVATE_KEY=

# Public RPC is fine for a hackathon deploy; override if you have your own.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional — only needed if you want `hardhat verify` to work on Etherscan.
ETHERSCAN_API_KEY=

# Optional — only needed to run the Supabase-backed identity registry
# (policy/identity-registry-supabase.js) and its tests
# (test/identity-registry-supabase.test.js). Without these set, that test
# file skips cleanly rather than failing, and everything else (including the
# in-memory identity-registry.js) works unaffected. Apply
# supabase/migrations/ (repo root) to the target project first — see that
# directory's README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
